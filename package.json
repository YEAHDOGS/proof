{
  "name": "@dogs/proof",
  "description": "PROOF — cited substance statistics (THC/cannabis, alcohol, and more; US and Texas): SDMX-inspired datasets with multi-source citations, query helpers, and map components. proof.wearedogs.net",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src/svelte"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./src/svelte/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svelte": {
      "svelte": "./src/svelte/index.js",
      "default": "./src/svelte/index.js"
    }
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "keywords": [
    "statistics",
    "cannabis",
    "thc",
    "alcohol",
    "samhsa",
    "nsduh",
    "nhtsa",
    "texas",
    "dataset"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib && tsc -p jsconfig.json --emitDeclarationOnly",
    "test": "vitest",
    "test:ui": "vitest run --ui",
    "test:ui:coverage": "vitest run --ui --coverage"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitejs/plugin-legacy": "^8.1.0",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.100.0",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
