{
  "name": "thc-stats",
  "description": "SDMX-inspired statistical datasets and query helpers for THC/cannabis and alcohol data (US and Texas), with cited sources.",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "statistics",
    "cannabis",
    "thc",
    "alcohol",
    "samhsa",
    "nsduh",
    "nhtsa",
    "texas",
    "dataset"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib && tsc -p jsconfig.json --emitDeclarationOnly",
    "test": "vitest",
    "test:ui": "vitest run --ui",
    "test:ui:coverage": "vitest run --ui --coverage"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitejs/plugin-legacy": "^8.1.0",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.100.0",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.1",
    "svelte-i18n": "^4.0.1"
  }
}
